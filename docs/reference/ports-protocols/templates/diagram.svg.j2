<text class="t-sub mid" x="1136" y="444">{{ t.hq_firewall.detail[1] }}</text>
<rect class="box" x="1028" y="560" width="216" height="84" rx="6"/>
<text class="t-title mid" x="1136" y="588">{{ t.clients.hq.name }}</text>
<text class="t-mono mid" x="1136" y="610">{{ t.enclaves.hq.cidr }}</text>

<line class="flow f-mgmt" x1="216" y1="142" x2="294" y2="142" marker-end="url(#m-mgmt)"/>
