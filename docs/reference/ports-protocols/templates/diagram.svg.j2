{%- macro node(h, x, y) -%}
<rect class="box" x="{{ x }}" y="{{ y }}" width="200" height="100" rx="6"/>
<text class="t-title mid" x="{{ x + 100 }}" y="{{ y + 28 }}">{{ h.name }}</text>
<text class="t-mono mid" x="{{ x + 100 }}" y="{{ y + 50 }}">{{ h.ip_line }}</text>
<text class="t-sub mid" x="{{ x + 100 }}" y="{{ y + 72 }}">{{ h.az_line }}</text>
{%- endmacro -%}
{%- macro badge(cat, x, y, label, r=11) -%}
<g class="badge b-{{ cat }}"><circle cx="{{ x }}" cy="{{ y }}" r="{{ r }}"/><text x="{{ x }}" y="{{ y + 4 }}">{{ label }}</text></g>
{%- endmacro -%}
<svg{% if standalone %} xmlns="http://www.w3.org/2000/svg"{% endif %} viewBox="0 0 1280 840" role="img" aria-label="{{ t.aria }}">
{%- if standalone %}
<style>{{ css }}</style>
{%- endif %}
<defs>
{%- for cat in ['mgmt', 'egress', 'aws', 'cluster', 'client', 'domain', 'gap'] %}
<marker id="m-{{ cat }}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="mk-{{ cat }}"/></marker>
{%- endfor %}
</defs>
{%- if standalone %}
<rect class="canvas" x="0" y="0" width="1280" height="840"/>
{%- endif %}

<rect class="zone z-net" x="16" y="40" width="220" height="784" rx="10"/>
<text class="zone-label" x="32" y="66">{{ t.enclaves.internet.label }}</text>
<rect class="zone z-vpc" x="272" y="40" width="700" height="784" rx="10"/>
<text class="zone-label" x="288" y="66">{{ t.enclaves.vpc.label }}</text>
<rect class="zone z-hq" x="1008" y="40" width="256" height="784" rx="10"/>
<text class="zone-label" x="1024" y="66">{{ t.enclaves.hq.label }}</text>

<rect class="box" x="36" y="110" width="180" height="64" rx="6"/>
<text class="t-title mid" x="126" y="138">{{ t.internet.runner.name }}</text>
<text class="t-sub mid" x="126" y="158">{{ t.internet.runner.detail }}</text>
<rect class="box" x="36" y="200" width="180" height="64" rx="6"/>
<text class="t-title mid" x="126" y="228">{{ t.internet.operator.name }}</text>
<text class="t-sub mid" x="126" y="248">{{ t.internet.operator.detail }}</text>
<rect class="box" x="36" y="606" width="180" height="72" rx="6"/>
<text class="t-title mid" x="126" y="636">{{ t.internet.endpoints.name }}</text>
<text class="t-sub mid" x="126" y="656">{{ t.internet.endpoints.detail }}</text>

<rect class="cluster" x="296" y="96" width="480" height="372" rx="10"/>
<text class="t-title" x="312" y="122">Failover cluster {{ t.cluster.name }}</text>
<text class="t-sub" x="312" y="140">File server role {{ t.cluster.role }} · {{ t.cluster.role_detail }}</text>
{{ node(hosts.node_a1, 316, 156) }}
{{ node(hosts.node_a2, 556, 156) }}
{{ node(hosts.node_b1, 316, 336) }}
{{ node(hosts.node_b2, 556, 336) }}
<text class="t-note mid" x="536" y="456">{{ t.cluster.address_legend }}</text>

<line class="flow f-cluster" x1="518" y1="206" x2="554" y2="206" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
<line class="flow f-cluster" x1="518" y1="386" x2="554" y2="386" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
<line class="flow f-cluster" x1="416" y1="258" x2="416" y2="334" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
<line class="flow f-cluster" x1="656" y1="258" x2="656" y2="334" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
<line class="flow f-cluster" x1="518" y1="258" x2="554" y2="334" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
<line class="flow f-cluster" x1="554" y1="258" x2="518" y2="334" marker-start="url(#m-cluster)" marker-end="url(#m-cluster)"/>
{{ badge('cluster', 536, 296, '5') }}

<rect class="box" x="316" y="520" width="200" height="84" rx="6"/>
