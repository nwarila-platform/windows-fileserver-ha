    {
      "id": "9",
      "category": "tunnel",
      "title": "Site tunnel",
      "scope": "VPC ↔ HQ across the Internet · site gateway group",
      "rows": [
        {
          "ref": "9.1",
          "service": "WireGuard, opened by HQ",
          "source": "HQ firewall",
          "destination": "{gateway}",
          "protection": "WireGuard",
          "note": "Every flow 7 (HQ) and 8 packet rides in the tunnel. HQ firewall rules are outside this register.",
          "binding": [
            {
              "kind": "gateway",
              "direction": "ingress",
              "rule": "wireguard",
              "cidr": "0.0.0.0/0"
            }
          ]
        },
        {
          "ref": "9.2",
          "service": "WireGuard, opened by the gateway",
          "source": "{gateway}",
          "destination": "HQ firewall",
          "protection": "WireGuard",
          "note": "The gateway opens the tunnel to HQ's endpoint by name; HQ is moving to answer only.",
          "binding": [
            {
              "kind": "gateway",
              "direction": "egress",
              "rule": "wireguard",
              "cidr": "0.0.0.0/0"
            }
          ]
        }
      ]
    },
    {
      "id": "G",
      "category": "gap",
      "title": "Not permitted, under evaluation",
      "scope": "",
      "rows": [
        {
          "ref": "G.1",
          "service": "SMB Witness (failover notification for CA shares)",
          "source": "SMB clients",
          "destination": "Node addresses",
          "protection": "Authenticated RPC",
          "note": "Without it, clients detect a failover by timeout. To be measured in the Tier 1 failover test before any change.",
          "binding": [
            {
              "kind": "gap",
              "proto": "tcp",
              "port": "135, 49152–65535"
            }
          ]
        }
      ]
    }
  ],
  "not_permitted": [
    "<code>636</code> LDAPS and <code>3269</code> Global Catalog over TLS to the DCs: no client uses them.",
    "<code>9389</code> AD Web Services: directory scripts run on the DC itself.",
    "<code>5985</code> WinRM between hosts: management uses SSH.",
    "<code>137–139</code> NetBIOS to the witness and from clients: SMB 2 and later use 445 only.",
    "<code>1194</code> OpenVPN: removed when the hosts moved to the site gateway.",
    "Any inbound from the Internet other than the two per-run addresses and the tunnel."
  ]
}
