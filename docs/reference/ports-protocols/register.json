{
  "boundaries": [
    {
      "title": "Internet → VPC",
      "text": "Only the run's GitHub runner and the operator, each as a single /32 created for that run, on SSH, RDP (operator only), WinRM-HTTPS and ICMP. The site gateway accepts the WireGuard tunnel on UDP 51820."
    },
    {
      "title": "VPC → Internet",
      "text": "The file server hosts reach the Internet on HTTPS (TCP 443) only. HTTP and public NTP are not permitted for them; the hosts try both, and those attempts are dropped."
    },
    {
      "title": "VPC ↔ HQ",
      "text": "Only through the WireGuard tunnel, which either end may open on UDP 51820. Hosts reach the two domain controllers on the domain member set; HQ clients reach the file server on TCP 445."
    }
  ],
  "flows": [
    {
      "id": "1",
      "category": "mgmt",
      "title": "Management from the CI runner",
      "scope": "Internet → VPC · run-scoped ingress group",
      "rows": [
        {
          "ref": "1.1",
          "service": "SSH (Ansible over OpenSSH)",
          "source": "GitHub runner /32",
          "destination": "All 5 hosts",
          "protection": "SSH",
          "note": "The deploy path.",
          "binding": [
            {
              "kind": "framework",
              "proto": "tcp",
              "port": "22"
            }
          ]
        },
        {
          "ref": "1.2",
          "service": "WinRM over HTTPS",
          "source": "GitHub runner /32",
          "destination": "All 5 hosts",
          "protection": "TLS",
          "note": "No listener on the hosts; connections are refused.",
          "binding": [
            {
              "kind": "framework",
              "proto": "tcp",
              "port": "5986"
            }
          ]
        },
        {
          "ref": "1.3",
          "service": "Reachability check",
          "source": "GitHub runner /32",
          "destination": "All 5 hosts",
          "protection": "—",
          "note": "",
          "binding": [
            {
              "kind": "framework",
              "proto": "icmp",
              "port": "all"
            }
          ]
        }
      ]
    },
    {
