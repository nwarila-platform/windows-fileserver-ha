          "source": "Operator /32",
          "destination": "All 5 hosts",
          "protection": "SSH",
          "note": "As the domain automation account; local Administrator is denied by the STIG.",
          "binding": [
            {
              "kind": "framework",
              "proto": "tcp",
              "port": "22"
            }
          ]
        },
        {
          "ref": "2.2",
          "service": "RDP",
          "source": "Operator /32",
          "destination": "All 5 hosts",
          "protection": "TLS",
          "note": "",
          "binding": [
            {
              "kind": "framework",
              "proto": "tcp",
              "port": "3389"
            }
          ]
        },
        {
          "ref": "2.3",
          "service": "WinRM over HTTPS",
          "source": "Operator /32",
          "destination": "All 5 hosts",
          "protection": "TLS",
          "note": "No listener on the hosts.",
          "binding": [
            {
              "kind": "framework",
              "proto": "tcp",
              "port": "5986"
            }
          ]
        },
        {
          "ref": "2.4",
          "service": "Reachability check",
          "source": "Operator /32",
          "destination": "All 5 hosts",
          "protection": "—",
          "note": "",
          "binding": [
            {
              "kind": "framework",
              "proto": "icmp",
              "port": "all"
            }
          ]
        }
      ]
    },
    {
      "id": "3",
      "category": "egress",
      "title": "Internet egress",
      "scope": "VPC → Internet · per-host groups",
      "rows": [
        {
          "ref": "3.1",
          "service": "HTTPS",
          "source": "All 5 hosts",
          "destination": "0.0.0.0/0",
          "protection": "TLS",
          "note": "Defender updates, SSM agent, Defender core service.",
          "binding": [
            {
              "kind": "host",
              "direction": "egress",
              "description": "HTTPS out",
              "cidr": "0.0.0.0/0"
            }
          ]
        },
        {
          "ref": "3.2",
          "service": "HTTP (certificate revocation, trust list downloads)",
          "source": "All 5 hosts",
          "destination": "Public CDN addresses",
          "protection": "—",
          "note": "Cryptographic Services retries; dropped by Windows and by the security group.",
          "binding": [
            {
              "kind": "not-permitted",
              "proto": "tcp",
              "port": "80"
            }
          ]
        },
        {
          "ref": "3.3",
          "service": "NTP to time.windows.com",
          "source": "All 5 hosts",
          "destination": "Public",
          "protection": "—",
          "note": "A manual time peer left by the image's AllSync setting.",
          "binding": [
            {
              "kind": "not-permitted",
              "proto": "udp",
              "port": "123"
            }
          ]
        }
      ]
    },
    {
      "id": "4",
      "category": "aws",
      "title": "AWS link-local services",
      "scope": "Inside the VPC · not filtered by security groups",
      "rows": [
        {
          "ref": "4.1",
          "service": "DNS (VPC resolver)",
          "source": "All 5 hosts",
          "destination": "10.0.0.2",
          "protection": "—",
          "note": "Names outside the domain; the domain zone is pinned to the DCs by NRPT.",
          "binding": [
            {
              "kind": "platform",
              "proto": "udp+tcp",
              "port": "53"
            }
          ]
        },
        {
          "ref": "4.2",
          "service": "Instance metadata (IMDS)",
          "source": "All 5 hosts",
          "destination": "169.254.169.254",
          "protection": "—",
          "note": "SSM agent, Defender.",
          "binding": [
            {
              "kind": "platform",
              "proto": "tcp",
              "port": "80"
            }
          ]
        },
        {
          "ref": "4.3",
          "service": "Amazon Time Sync",
          "source": "All 5 hosts",
          "destination": "169.254.169.123",
          "protection": "—",
          "note": "The hosts' current time source.",
          "binding": [
            {
              "kind": "platform",
              "proto": "udp",
              "port": "123"
            }
          ]
        },
        {
          "ref": "4.4",
          "service": "Windows activation (KMS)",
          "source": "All 5 hosts",
          "destination": "169.254.169.250",
          "protection": "—",
          "note": "Once at boot.",
          "binding": [
            {
              "kind": "platform",
              "proto": "tcp",
              "port": "1688"
            }
          ]
        },
        {
          "ref": "4.5",
          "service": "DHCP",
          "source": "All 5 hosts",
          "destination": "VPC router",
          "protection": "—",
          "note": "",
          "binding": [
            {
              "kind": "platform",
              "proto": "udp",
              "port": "67"
            }
          ]
        }
      ]
