    {
      "id": "5",
      "category": "cluster",
      "title": "Node ↔ node",
      "scope": "Inside the VPC · each node admits only its three peers' node addresses (.10)",
      "rows": [
        {
          "ref": "5.1",
          "service": "Cluster heartbeat and messaging",
          "source": "Each node",
          "destination": "Its 3 peers",
          "protection": "DTLS",
          "note": "Also carries the cluster's internal virtual adapter traffic.",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC cluster service UDP (from|to) .+",
              "peer_scope": true
            }
          ]
        },
        {
          "ref": "5.2",
          "service": "Cluster join",
          "source": "Each node",
          "destination": "Its 3 peers",
          "protection": "—",
          "note": "Every restart is a rejoin, so this stays open.",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC cluster service TCP (from|to) .+",
              "peer_scope": true
            }
          ]
        },
        {
          "ref": "5.3",
          "service": "RPC endpoint mapper",
          "source": "Each node",
          "destination": "Its 3 peers",
          "protection": "Authenticated RPC",
          "note": "",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC RPC endpoint mapper (from|to) .+",
              "peer_scope": true
            }
          ]
        },
        {
          "ref": "5.4",
          "service": "Dynamic RPC (cluster API, WMI, service control)",
          "source": "Each node",
          "destination": "Its 3 peers",
          "protection": "Authenticated RPC",
          "note": "",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC dynamic RPC (from|to) .+",
              "peer_scope": true
            }
          ]
        },
        {
          "ref": "5.5",
          "service": "SMB (add node, validation)",
          "source": "Each node",
          "destination": "Peers",
          "protection": "SMB signing",
          "note": "Admitted by the broader \"Clustered SMB\" rule, not a per-peer rule.",
          "binding": [
            {
              "kind": "host",
              "description": "Clustered SMB (from|to) private networks",
              "cidr": "10.0.0.0/16",
              "allow_shared_rule": true
            }
          ],
          "enforced_by": "Per-host groups (10.0.0.0/16 rule)"
        },
        {
          "ref": "5.6",
          "service": "Validation, add node",
          "source": "Each node",
          "destination": "Its 3 peers (.10)",
          "protection": "—",
          "note": "Pings to peers' .11 and .12 addresses are not permitted and are dropped, with no failure seen.",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC ICMP (from|to) .+",
              "peer_scope": true
            }
          ]
        },
        {
          "ref": "5.7",
          "service": "NetBIOS name service (\"Cluster Administrator\")",
          "source": "Each node",
          "destination": "Its 3 peers",
          "protection": "—",
          "note": "Microsoft lists it without a stated function; SMB 2 and later do not use NetBIOS.",
          "binding": [
            {
              "kind": "host",
              "description": "WSFC NetBIOS name resolution (from|to) .+",
              "peer_scope": true
            }
          ]
        }
